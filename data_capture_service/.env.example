# =============================================================================
# Data Capture Service - Environment Variables
# =============================================================================
# Copy this file to .env.dev and fill in the values.

# --- Core Service Settings ---
DATA_CAPTURE_SERVICE_PROJECT_NAME=Data Capture Service
DATA_CAPTURE_SERVICE_ENVIRONMENT=development
DATA_CAPTURE_SERVICE_ROOT_PATH=/api/v1
DATA_CAPTURE_SERVICE_LOGGING_LEVEL=INFO

# --- Database ---
# PostgreSQL connection string (psycopg3 async driver)
DATA_CAPTURE_SERVICE_DATABASE_URL=postgresql+psycopg://postgres:your-password@db.your-project.supabase.co:5432/postgres

# --- Auth Service (M2M Token Acquisition) ---
DATA_CAPTURE_SERVICE_AUTH_SERVICE_URL=http://auth_service:8000/api/v1
DATA_CAPTURE_SERVICE_M2M_CLIENT_ID=your-m2m-client-id
DATA_CAPTURE_SERVICE_M2M_CLIENT_SECRET=your-m2m-client-secret
DATA_CAPTURE_SERVICE_M2M_JWT_SECRET_KEY=your-jwt-secret-key
DATA_CAPTURE_SERVICE_M2M_JWT_AUDIENCE=paservices_microservices
DATA_CAPTURE_SERVICE_AUTH_SERVICE_ISSUER=paservices_auth_service
DATA_CAPTURE_SERVICE_AUTH_SERVICE_JWT_ALGORITHM=RS256
# DATA_CAPTURE_SERVICE_AUTH_SERVICE_JWKS_URL=  # Optional: override JWKS endpoint

# --- Super ID Service ---
DATA_CAPTURE_SERVICE_SUPER_ID_SERVICE_URL=http://super_id_service:8000/api/v1

# --- Firecrawl Baseline Provider ---
# If not set, the baseline provider is disabled and the validation gate becomes pass-through
DATA_CAPTURE_SERVICE_FIRECRAWL_API_KEY=fc-your-firecrawl-api-key

# --- Motie Adapter ---
DATA_CAPTURE_SERVICE_MOTIE_BASE_URL=https://app.motie.dev
DATA_CAPTURE_SERVICE_MOTIE_API_TOKEN=mtk_your-motie-api-token
DATA_CAPTURE_SERVICE_MOTIE_POLL_TIMEOUT=300.0
DATA_CAPTURE_SERVICE_MOTIE_POLL_INTERVAL=5.0
DATA_CAPTURE_SERVICE_MOTIE_POLL_BACKOFF=1.5
DATA_CAPTURE_SERVICE_MOTIE_POLL_MAX_INTERVAL=30.0

# --- Adapter Feature Flags ---
DATA_CAPTURE_SERVICE_ADAPTER_MOTIE_ENABLED=true
DATA_CAPTURE_SERVICE_ADAPTER_FIRECRAWL_EXTRACT_ENABLED=false

# --- Pipeline Configuration ---
DATA_CAPTURE_SERVICE_VALIDATION_GATE_ENABLED=true
DATA_CAPTURE_SERVICE_COMPLETENESS_ACCEPT_THRESHOLD=0.85
DATA_CAPTURE_SERVICE_COMPLETENESS_FALLBACK_THRESHOLD=0.7
DATA_CAPTURE_SERVICE_MAX_RETRIES_PER_ADAPTER=1

# --- Rate Limiting ---
DATA_CAPTURE_SERVICE_RATE_LIMIT_REQUESTS_PER_MINUTE=30
DATA_CAPTURE_SERVICE_REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# DATA_CAPTURE_SERVICE_CORS_ALLOW_ORIGINS=["*"]

# --- Status Notifications (S3 + Webhook) ---
# DATA_CAPTURE_SERVICE_STATUS_WEBHOOK_URL=
# DATA_CAPTURE_SERVICE_STATUS_WEBHOOK_HEADERS={}
# DATA_CAPTURE_SERVICE_STATUS_S3_BUCKET_NAME=
# DATA_CAPTURE_SERVICE_STATUS_S3_REGION=
# DATA_CAPTURE_SERVICE_STATUS_S3_PREFIX=data_capture/status
# DATA_CAPTURE_SERVICE_STATUS_S3_PUBLIC_BASE_URL=
# DATA_CAPTURE_SERVICE_STATUS_S3_ENDPOINT_URL=

# --- AWS (optional, falls back to default provider chain) ---
# DATA_CAPTURE_SERVICE_AWS_ACCESS_KEY_ID=
# DATA_CAPTURE_SERVICE_AWS_SECRET_ACCESS_KEY=
# DATA_CAPTURE_SERVICE_AWS_SESSION_TOKEN=
