# pa_mcp/Dockerfile.prod

# --- Stage 1: Builder ---
# Install production dependencies into a project-local virtual environment.
FROM python:3.12-slim AS builder

ENV POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=true \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install Poetry
RUN pip install poetry

# Copy dependency definitions first to leverage Docker layer caching
COPY pyproject.toml poetry.lock ./

# Install only the main (non-dev) dependencies
RUN poetry install --no-root --only main


# --- Stage 2: Final Production Image ---
FROM python:3.12-slim AS final

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/src"

WORKDIR /app

# Create non-root user
RUN addgroup --system appuser && adduser --system --ingroup appuser appuser

# Copy the virtual environment from the builder stage
COPY --from=builder /app/.venv /app/.venv

# Copy application code and database migrations
COPY ./src ./src
COPY ./alembic ./alembic
COPY alembic.ini .

# Adjust ownership
RUN chown -R appuser:appuser /app

# Switch to the non-root user
USER appuser

EXPOSE 8000

# Run the MCP server
CMD ["uvicorn", "pa_mcp.server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
